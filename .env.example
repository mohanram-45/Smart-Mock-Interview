# Copy to .env (Docker Compose reads it automatically). Every value shown is the DEFAULT; remove the ones you do not change.
# Never put credentials in this file: the app needs none, and no paid API is ever used.

# --- publishing & container limits --------------------------------------------------------------------------
SMART_PUBLISH_PORT=5000                 # host port; always bound to 127.0.0.1 in Docker Compose
SMART_APP_MEM_LIMIT=1g

# --- host server (direct execution via main/app.py) ---------------------------------------------------------
SMART_HOST=127.0.0.1                    # interface to bind; 127.0.0.1 (loopback) protects candidate answers from network exposure
SMART_PORT=5000                         # port for direct host runs (main/app.py)
SMART_DEBUG=0                           # 1 = Werkzeug interactive debugger (off by default to prevent browser code execution)
SMART_FORBID_MODEL_TRAINING=0           # 1 = refuse on-request Bi-LSTM training if checkpoint is missing (set to 1 in Docker/CI)

# --- build --------------------------------------------------------------------------------------------------
SMART_PYTHON_IMAGE=python:3.13-slim-bookworm   # pin a digest here: python:3.13-slim-bookworm@sha256:<digest>  (docs/MLOPS.md)
SMART_INSTALL_ML=0                      # 1 = install torch + sentence-transformers + faiss in the image (large; not built/verified in the sandbox)
SMART_GIT_COMMIT=unknown                # shown by /healthz; e.g. $(git rev-parse --short HEAD)

# --- application & demo session -----------------------------------------------------------------------------
SMART_DEMO_LEGACY_MODEL=bilstm          # bilstm | bert | tfidf (needs INSTALL_ML=1 and weights; otherwise the demo shows "scorer not set up")
SMART_DEMO_DATA_DIR=results/demo_sessions # location where session files are stored atomically
SMART_DEMO_HISTORY=1                    # 1 = allow session history; default restricts to loopback clients; 0 = disable history
SMART_DEMO_RETENTION_DAYS=14            # retention period; older session files are purged at startup
SMART_DEMO_ALLOW_SCORER_SETUP=0         # 1 = allow demo to train/download missing scorer on first use; 0 = prevent long jobs on requests

# --- experimental features (OFF by default) -----------------------------------------------------------------
SMART_DEMO_LIVE_MODULAR=0               # 1 = offer live Qwen modular evaluation (needs Ollama; experimental, abstains often, NOT validated)
SMART_DEMO_OLLAMA_HOST=http://ollama:11434   # compose service; for Ollama running on the Windows host use http://host.docker.internal:11434
SMART_DEMO_QWEN_MODEL=qwen2.5:7b
SMART_DEMO_CODE_EVAL=0                  # 1 = static code check option (read-only AST analysis; never executes code)
# SMART_CODEEVAL_EXEC=docker            # docker = execute behavior tests in local sandbox; default is read-only static analysis
# SMART_CODEEVAL_IMAGE=smart-codeeval:numpy # Docker image for codeeval tests (built locally; never pulled automatically)
# SMART_DEMO_FOLLOWUP_ENGINE=stage10n   # stage10n (default, prompt 10.fu8) | objective (experimental Stage 11 prompt 11.obj1/obj2)

# --- retrieval & corpus -------------------------------------------------------------------------------------
SMART_QUESTION_SOURCE=legacy            # curated = legacy API draws from the 666-record corpus
SMART_RETRIEVAL_ENABLED=0               # 1 = /api/retrieval/* (needs INSTALL_ML=1 and the embedding model)
SMART_RETRIEVAL_BACKEND=minilm          # embedding backend (minilm)
SMART_RETRIEVAL_MODEL=sentence-transformers/all-MiniLM-L6-v2 # embedding model identifier
SMART_RETRIEVAL_DOC_FORMAT=qk_concise   # document text representation: qk_concise | qka | qk
SMART_RETRIEVAL_LOCAL_ONLY=1            # 1 = forbid runtime model downloads from HuggingFace
SMART_RETRIEVAL_WARMUP=0                # 1 = pre-load model + index in background thread on startup
SMART_RETRIEVAL_EXPOSE_REFERENCE=0      # 1 = include reference answers in retrieval API responses (redacted by default)

# 1 = the container never downloads a model. To fill the model cache ONCE (a ~90 MB download that needs your approval; INSTALL_ML=1 image only):
#   docker compose run --rm -e HF_HUB_OFFLINE=0 -e TRANSFORMERS_OFFLINE=0 app python -c "from sentence_transformers import SentenceTransformer as S; S('sentence-transformers/all-MiniLM-L6-v2')"
SMART_HF_OFFLINE=1

# --- observability & MLOps ----------------------------------------------------------------------------------
SMART_JSON_LOGS=1                       # 1 = structured JSON access logs on smart.access
SMART_ACCESS_LOG=1                      # 1 = per-request access log line; 0 = silence per-request line while keeping metrics
SMART_METRICS_ENABLED=1                 # 1 = expose Prometheus-compatible GET /metrics; 0 = returns 404
SMART_OBS_PROBE_OLLAMA=0                # 1 = /readyz makes a 1-second reachability call to Ollama

# --- optional ollama service (Docker Compose) ---------------------------------------------------------------
# OLLAMA_IMAGE=ollama/ollama:latest      # pin a tag for reproducibility

# --- local MLflow (host, not Docker) -------------------------------------------------------------------------
# MLFLOW_TRACKING_URI=sqlite:///mlflow/mlflow.db
# SMART_MLFLOW_ARTIFACTS=mlflow/artifacts

# --- optional LLM evaluation backend (src/evaluation) -------------------------------------------------------
# SMART_EVALUATION_BACKEND=legacy       # legacy (default) | llm (switches legacy /api evaluation backend; not used by demo)
# SMART_LLM_PROVIDER=none               # none (default) | ollama | mock | anthropic | openai_compatible
# SMART_LLM_MODEL=qwen2.5:7b            # model name for evaluation provider
# SMART_LLM_ALLOW_PAID=0                # 1 = allow paid hosted providers; 0 = local Ollama only
# SMART_LLM_TIMEOUT_S=60                # per-call evaluation timeout in seconds (1..300)
